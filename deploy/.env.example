# 复制为 .env 后填写；.env 含私密配置，勿提交仓库、勿进前端（§12A.3/5）。
# 歌单数据由江衍维护，站点侧不写死曲目。

# —— 主站侧 Folia 集成（v30；src/lib/config.ts 读取，构建时注入）——
# Folia 基地址（域名 + https 已生效）
PUBLIC_FOLIA_BASE=https://nijingzh.top:81
# 全屏歌词演出路由（Folia 实际路由不对时改这里）
PUBLIC_FOLIA_STAGE_PATH=/player/stage
# 歌单 ID（网易云歌单「江-衍喜欢的音乐」；留空 = 播放器不工作）
PUBLIC_FOLIA_PLAYLIST_ID=593219640

# —— Folia 服务端（deploy/ 用）——
# Folia 镜像（等江衍确认部署形态后填实）
FOLIA_IMAGE=

# 在线音源：按 Folia 官方文档配置（音源 API 为实现细节）
FOLIA_ONLINE_SOURCE_API=
FOLIA_ONLINE_SOURCE_KEY=

# —— 全曲试听（重要：这里没有可填的变量，见下）——
# 试听 30~45 秒 = 网易「未登录」限制，不是配置问题。解法两条：
#   1) Folia 里扫码登录网易云账号（主路径，Folia 播放全部全曲）；
#   2) 主站 nginx 的 /api/ 反代里加一行注入 Cookie（主站播放器也全曲）：
#        proxy_set_header Cookie "MUSIC_U=...; __csrf=...";
#      Cookie 等同账号密码，只放服务器 nginx 配置里，不进 git、不进前端、不给任何人看。
# （曾误传 NCL_COOKIE 环境变量，实测 Folia 与 api-enhanced 均不认，已删。）

# 管理端口令（nginx basic auth 用；htpasswd 生成）
# ADMIN_BASIC_AUTH=
