[Unit]
Description=Yanschul like counter (zero-dep node server)
After=network.target

[Service]
# 这是模板；推荐直接用 sudo bash deploy/like-server/install.sh，
# 脚本会按仓库实际路径和 node 实际路径生成 unit，不用手改。
# 手动装时把下面两行改成你服务器上的实际路径：
#   WorkingDirectory = deploy/like-server 的绝对路径
#   ExecStart 的 node = which node 查出来的绝对路径
WorkingDirectory=/opt/Yanschul-digital-space/deploy/like-server
ExecStart=/usr/bin/node server.cjs
Restart=always
RestartSec=3
Environment=NODE_ENV=production
Environment=LIKE_COOLDOWN_MS=2000

[Install]
WantedBy=multi-user.target
