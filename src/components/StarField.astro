---
/**
 * StarField · 全站背景星芒粒子（v26 · 更多/更亮/更大）
 * 16 颗星芒缓慢飘散 + 呼吸，只用 transform/opacity，尊重 reduced-motion。
 * fixed 背景层（z-index -1），不挡内容。
 */
---

<div class="starfield" aria-hidden="true">
  <span class="sf-star" style="--x:6%;--y:12%;--s:20px;--d:0s;--dur:7s">✦</span>
  <span class="sf-star" style="--x:17%;--y:40%;--s:13px;--d:1.1s;--dur:8.5s">✦</span>
  <span class="sf-star" style="--x:28%;--y:22%;--s:16px;--d:2.3s;--dur:7.8s">✦</span>
  <span class="sf-star" style="--x:38%;--y:62%;--s:12px;--d:0.6s;--dur:9s">✦</span>
  <span class="sf-star" style="--x:48%;--y:16%;--s:22px;--d:3.1s;--dur:7.2s">✦</span>
  <span class="sf-star" style="--x:58%;--y:48%;--s:14px;--d:1.7s;--dur:8.2s">✦</span>
  <span class="sf-star" style="--x:68%;--y:28%;--s:18px;--d:2.9s;--dur:7.6s">✦</span>
  <span class="sf-star" style="--x:78%;--y:66%;--s:12px;--d:0.9s;--dur:8.8s">✦</span>
  <span class="sf-star" style="--x:88%;--y:18%;--s:16px;--d:3.6s;--dur:7.4s">✦</span>
  <span class="sf-star" style="--x:94%;--y:52%;--s:13px;--d:2.1s;--dur:8.4s">✦</span>
  <span class="sf-star" style="--x:12%;--y:78%;--s:15px;--d:1.4s;--dur:7.9s">✦</span>
  <span class="sf-star" style="--x:32%;--y:88%;--s:12px;--d:2.7s;--dur:9.2s">✦</span>
  <span class="sf-star" style="--x:52%;--y:82%;--s:18px;--d:0.3s;--dur:7.5s">✦</span>
  <span class="sf-star" style="--x:72%;--y:90%;--s:14px;--d:3.4s;--dur:8.1s">✦</span>
  <span class="sf-star" style="--x:8%;--y:56%;--s:17px;--d:2.5s;--dur:7.7s">✦</span>
  <span class="sf-star" style="--x:92%;--y:82%;--s:12px;--d:1.9s;--dur:8.6s">✦</span>
</div>

<style>
  .starfield {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .sf-star {
    position: absolute;
    left: var(--x);
    top: var(--y);
    font-size: var(--s);
    color: rgba(155, 138, 168, 0.7);
    animation: sf-drift var(--dur) ease-in-out infinite;
    animation-delay: var(--d);
    will-change: transform, opacity;
  }
  @keyframes sf-drift {
    0%, 100% { transform: translateY(0) scale(0.88); opacity: 0.35; }
    50% { transform: translateY(-26px) scale(1.18); opacity: 0.85; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sf-star { animation: none; opacity: 0.6; }
  }
</style>
