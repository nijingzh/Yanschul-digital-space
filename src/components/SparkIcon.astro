---
/**
 * 星芒语法图标（任务单 v17 · A）：六枚同源同语言，全部从「星芒 + 发丝线」衍生。
 * 规格：1.5px 描边、18px、#1D1D22 @65%（opacity 表达）。
 * hover：描边 100% + y −2px + 2° 微转 / 700ms（只 transform/opacity）。
 * 禁外部图标库风格；新增图标必须走同一语法。
 */
interface Props {
  name: 'home' | 'articles' | 'projects' | 'learning' | 'life' | 'about';
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  class:list={['spark-icon', className]}
  width="18"
  height="18"
  viewBox="0 0 18 18"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'home' && (
      <>
        {/* 首页 = 四芒星 */}
        <path d="M9 2.5 L10.1 7.9 15.5 9 10.1 10.1 9 15.5 7.9 10.1 2.5 9 7.9 7.9 Z" />
        <path d="M14.6 3.4 L14.95 4.45 16 4.8 14.95 5.15 14.6 6.2 14.25 5.15 13.2 4.8 14.25 4.45 Z" stroke-width="1" />
      </>
    )
  }
  {
    name === 'articles' && (
      <>
        {/* 文章 = 书页角折出星芒点 */}
        <path d="M3.5 3 L11 3 L14.5 6.5 L14.5 15 L3.5 15 Z" />
        <path d="M11 3 L11 6.5 L14.5 6.5" />
        <path d="M6.4 10 L6.7 11 7.7 11.3 6.7 11.6 6.4 12.6 6.1 11.6 5.1 11.3 6.1 11 Z" stroke-width="1" />
      </>
    )
  }
  {
    name === 'projects' && (
      <>
        {/* 项目 = 方块上落星芒 */}
        <path d="M3.5 7 L9 4.2 L14.5 7 L14.5 13 L9 15.8 L3.5 13 Z" />
        <path d="M8.6 0.8 L8.95 1.85 10 2.2 8.95 2.55 8.6 3.6 8.25 2.55 7.2 2.2 8.25 1.85 Z" stroke-width="1" />
      </>
    )
  }
  {
    name === 'learning' && (
      <>
        {/* 学习 = 刻度尺端点星 */}
        <path d="M2.5 11 L13 11" />
        <path d="M5 11 L5 8.6 M8 11 L8 9.4 M11 11 L11 8.6" stroke-width="1" />
        <path d="M14.3 7.2 L14.6 8.25 15.65 8.6 14.6 8.95 14.3 10 14 8.95 12.95 8.6 14 8.25 Z" stroke-width="1" />
      </>
    )
  }
  {
    name === 'life' && (
      <>
        {/* 生活 = 碗口一点光 */}
        <path d="M3 8.6 C3 12.4 5.7 15 9 15 C12.3 15 15 12.4 15 8.6 Z" />
        <path d="M2.2 8.6 L15.8 8.6" stroke-width="1" />
        <path d="M8.6 3 L8.9 4.05 9.95 4.4 8.9 4.75 8.6 5.8 8.3 4.75 7.25 4.4 8.3 4.05 Z" stroke-width="1" />
      </>
    )
  }
  {
    name === 'about' && (
      <>
        {/* 关于 = 门牌挂星 */}
        <path d="M4.5 2.5 L13.5 2.5 L13.5 11 L9 14 L4.5 11 Z" />
        <path d="M7 6 L11 6 M7 8.4 L10 8.4" stroke-width="1" />
        <path d="M8.7 15 L8.9 15.7 9.6 15.9 8.9 16.1 8.7 16.8 8.5 16.1 7.8 15.9 8.5 15.7 Z" stroke-width="1" />
      </>
    )
  }
</svg>

<style>
  .spark-icon {
    flex: 0 0 auto;
    /* 图标不随渐变字透明化：固定墨色，描边透明度仍用 opacity 表达 */
    color: var(--color-ink);
    opacity: 0.65;
    transition:
      opacity 700ms var(--ease-space),
      transform 700ms var(--ease-space);
  }

  a:hover .spark-icon,
  .icon-hover:hover .spark-icon {
    opacity: 1;
    transform: translateY(-2px) rotate(2deg);
  }
</style>
