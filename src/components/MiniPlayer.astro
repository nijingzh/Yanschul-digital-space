---
/**
 * MiniPlayer —— 全站极简播放态（裁决 §12.2）
 *
 * 一行小字「♪ 歌名 – 歌手」+ 播放/暂停；等宽字、无进度条、无封面墙。
 * 常驻控件不参与入场编排。
 *
 * v30 · Folia 接入（注释预定路线「Folia 接入后改取播放器状态」）：
 * 配置 PUBLIC_FOLIA_PLAYLIST_ID 后曲目与音源取自 Folia（网易云 API）歌单——
 * /api/playlist/track/all 拉曲目、/api/song/url/v1 取音源，曲终自动下一首；
 * 未配置或拉取失败自动降级 mediaNotes「在听」占位态（站点侧不写死曲目）。
 * 地址单点可配：src/lib/config.ts（IP:81 → music.nijingzh.top 只改 env）。
 */
import { getMediaNotes } from '../data/content';
import { FOLIA_BASE, FOLIA_PLAYLIST_ID } from '../lib/config';

const mediaNotes = await getMediaNotes();
// v31：占位文案中性化（真曲目由 Folia 歌单加载后接管；「夜航西飞」示例数据退休）
const fallbackTrack = '未在播放';
---

<div class="mini-player" data-mini-player data-folia-base={FOLIA_BASE} data-playlist-id={FOLIA_PLAYLIST_ID} transition:persist="mini-player">
  <span class="mini-track" data-mini-track>♪ {fallbackTrack}</span>
  <button class="mini-toggle mono" type="button" data-mini-toggle aria-pressed="false">播放</button>
  <audio data-mini-audio preload="none"></audio>
</div>

<script>
  // v30 Folia 歌单真播放 + 降级占位（未配置 / 拉取失败走原纯文案切换）
  const root = document.querySelector<HTMLElement>('[data-mini-player]');
  const trackEl = document.querySelector<HTMLElement>('[data-mini-track]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-mini-toggle]');
  const audio = document.querySelector<HTMLAudioElement>('[data-mini-audio]');

  const base = (root && root.getAttribute('data-folia-base')) || '';
  const playlistId = (root && root.getAttribute('data-playlist-id')) || '';

  interface Track {
    id: number;
    text: string;
    title: string;
    artist: string;
    pic: string;
    url?: string;
  }
  let tracks: Track[] = [];
  let index = 0;

  const api = (path: string): string => base + '/api' + path;

  const renderTrack = (): void => {
    if (trackEl && tracks[index]) trackEl.textContent = tracks[index].text;
    // v31：广播当前曲目（音乐空间 CD 卡同源监听 jy:track）
    const t = tracks[index];
    if (t) {
      document.dispatchEvent(
        new CustomEvent('jy:track', {
          detail: { id: t.id, title: t.title, artist: t.artist, pic: t.pic },
        })
      );
    }
  };

  const setToggle = (playing: boolean): void => {
    if (!toggle) return;
    toggle.setAttribute('aria-pressed', String(playing));
    toggle.textContent = playing ? '暂停' : '播放';
  };

  // 预取音源 URL：点击时必须同步 play()——点击后再 await fetch 会脱离用户手势栈，
  // 被浏览器 autoplay 策略拒绝（v30 实测坑）
  const prefetch = (i: number): void => {
    const t = tracks[i % Math.max(tracks.length, 1)];
    if (!t || t.url || !base) return;
    fetch(api('/song/url/v1?id=' + t.id + '&level=exhigh'))
      .then((res) => res.json())
      .then((data) => {
        const url = data && data.data && data.data[0] && data.data[0].url;
        if (url) t.url = url;
      })
      .catch(() => {
        // 失败不打扰；点击时会走未就绪兜底
      });
  };

  const playCurrent = (): void => {
    if (!audio || !tracks[index]) return;
    const t = tracks[index];
    if (t.url) {
      audio.src = t.url;
      const pr = audio.play();
      if (pr && typeof pr.then === 'function') {
        pr.then(() => setToggle(true), () => setToggle(false));
      } else {
        setToggle(true);
      }
      prefetch(index + 1);
      return;
    }
    // URL 未就绪（预取没赶上）：取 URL 再播——play 落在 await 之后可能被拒，按钮态如实回退
    fetch(api('/song/url/v1?id=' + t.id + '&level=exhigh'))
      .then((res) => res.json())
      .then((data) => {
        const url = data && data.data && data.data[0] && data.data[0].url;
        if (!url) {
          next();
          return;
        }
        t.url = url;
        audio.src = url;
        return audio.play();
      })
      .then(() => setToggle(true), () => setToggle(false));
  };

  const next = (): void => {
    if (!tracks.length) return;
    index = (index + 1) % tracks.length;
    renderTrack();
    playCurrent();
  };

  const prev = (): void => {
    if (!tracks.length) return;
    index = (index - 1 + tracks.length) % tracks.length;
    renderTrack();
    playCurrent();
  };

  const loadPlaylist = async (): Promise<void> => {
    if (!base || !playlistId) return;
    try {
      const res = await fetch(api('/playlist/track/all?id=' + encodeURIComponent(playlistId) + '&limit=50'));
      if (!res.ok) return;
      const data = await res.json();
      const songs = (data && data.songs) || [];
      tracks = songs.slice(0, 50).map((s: { id: number; name: string; ar?: { name?: string }[]; al?: { picUrl?: string } }) => ({
        id: s.id,
        text: '♪ ' + s.name + (s.ar && s.ar[0] && s.ar[0].name ? ' – ' + s.ar[0].name : ''),
        title: s.name,
        artist: (s.ar && s.ar[0] && s.ar[0].name) || '',
        pic: (s.al && s.al.picUrl ? s.al.picUrl.replace(/^http:/, 'https:') : ''),
      }));
      renderTrack();
      prefetch(0);
    } catch {
      // 降级：保持占位文案（网络/接口失败不打扰）
    }
  };

  if (audio) audio.addEventListener('ended', next);

  // v34：播放状态三方同步协议（CD 卡 / 歌词演出同源监听——同一 audio 唯一内核）
  if (audio) {
    const broadcastState = (playing: boolean): void => {
      document.dispatchEvent(
        new CustomEvent('jy:player', {
          detail: { playing: playing, t: audio.currentTime || 0, d: audio.duration || 0 },
        })
      );
    };
    audio.addEventListener('play', () => broadcastState(true));
    audio.addEventListener('pause', () => broadcastState(false));
    audio.addEventListener('timeupdate', () => {
      document.dispatchEvent(
        new CustomEvent('jy:player-tick', {
          detail: { t: audio.currentTime || 0, d: audio.duration || 0 },
        })
      );
    });
  }

  // v34：外部控制指令（歌词演出控制条 / CD 卡播放钮）
  document.addEventListener('jy:player-cmd', (e) => {
    const detail = ((e as CustomEvent<{ cmd?: string; t?: number }>).detail || {}) as { cmd?: string; t?: number };
    if (detail.cmd === 'toggle') {
      if (toggle) toggle.click();
    } else if (detail.cmd === 'next') {
      next();
    } else if (detail.cmd === 'prev') {
      prev();
    } else if (detail.cmd === 'seek' && audio && typeof detail.t === 'number') {
      audio.currentTime = detail.t;
    }
  });

  // v36：SPA 导航后向新页面重播状态（jy:track/jy:player——MiniPlayer persist 不重建，新 DOM 需要补状态）
  document.addEventListener('astro:page-load', () => {
    const t = tracks[index];
    if (t) {
      document.dispatchEvent(
        new CustomEvent('jy:track', {
          detail: { id: t.id, title: t.title, artist: t.artist, pic: t.pic },
        })
      );
    }
    if (audio) {
      document.dispatchEvent(
        new CustomEvent('jy:player', {
          detail: { playing: !audio.paused, t: audio.currentTime || 0, d: audio.duration || 0 },
        })
      );
    }
  });

  if (toggle) {
    toggle.addEventListener('click', () => {
      const playing = toggle.getAttribute('aria-pressed') === 'true';
      if (tracks.length) {
        if (playing) {
          if (audio) audio.pause();
          setToggle(false);
        } else {
          playCurrent();
        }
      } else {
        // 占位态：只切文案（不写死地址、不加载真实音源；dev 下占位不报错）
        setToggle(!playing);
      }
    });
  }

  loadPlaylist();
</script>
