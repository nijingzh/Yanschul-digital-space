---
// 归档页 —— v23 P3：按年月时间线（年份大字 + 月份分组 + 计数）
import Base from '../layouts/Base.astro';
import { getFeedItems } from '../data/content';
import SparkIcon from '../components/SparkIcon.astro';

const items = await getFeedItems();
// 按年份 → 月份分组（倒序）
const byYear = new Map<string, Map<string, typeof items>>();
for (const it of items) {
  const [y, m] = it.date.split('-');
  if (!byYear.has(y)) byYear.set(y, new Map());
  const months = byYear.get(y)!;
  if (!months.has(m)) months.set(m, []);
  months.get(m)!.push(it);
}
const years = [...byYear.entries()].sort((a, b) => b[0].localeCompare(a[0]));
const total = items.length;
---

<Base title="归档" description="按时间归档的全部记录。">
  <div class="archive-room">
    <div class="room-cool" aria-hidden="true"></div>

    <header class="archive-head">
      <p class="mono archive-eyebrow" data-enter>SPACE 06 / ARCHIVE</p>
      <h1 class="page-title archive-title icon-hover" data-enter><SparkIcon name="articles" />归档</h1>
      <p class="lead archive-lead" data-enter>全部 {total} 条记录，按时间排的队。</p>
    </header>

    {
      years.map(([year, months]) => (
        <section class="archive-year" data-reveal-group aria-label={year + ' 年'}>
          <h2 class="year-no serif" data-enter-char data-text={year}>{year}</h2>
          {
            [...months.entries()]
              .sort((a, b) => b[0].localeCompare(a[0]))
              .map(([month, list]) => (
                <div class="month-group" data-reveal-item>
                  <p class="mono month-label">{Number(month)} 月 · {list.length}</p>
                  <ol class="month-list">
                    {list.map((it) => (
                      <li>
                        <a class="arch-item magnetic pressable" href={it.href}>
                          <time class="mono">{it.date.replaceAll('-', '.')}</time>
                          <span class="serif">{it.title}</span>
                        </a>
                      </li>
                    ))}
                  </ol>
                </div>
              ))
          }
        </section>
      ))
    }
  </div>
</Base>

<style>
  .archive-room {
    position: relative;
    padding-block: clamp(2.2rem, 5vh, 3.6rem);
  }

  .room-cool {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background: var(--color-panel-2);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 88%, transparent);
    pointer-events: none;
  }

  .archive-head,
  .archive-year {
    position: relative;
    width: calc(100% - 3rem);
    max-width: 56rem;
    margin-inline: auto;
  }

  .archive-head {
    margin-bottom: clamp(2.5rem, 6vh, 4.5rem);
  }

  .archive-eyebrow {
    color: var(--color-ink-2);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
  }

  .archive-title {
    margin-top: 0.9rem;
    font-size: clamp(2.15rem, 5vw, 3.15rem);
    letter-spacing: 0.04em;
  }

  .archive-lead {
    margin-top: 1.1rem;
    max-width: 42ch;
    color: var(--color-ink-2);
  }

  .archive-year {
    margin-bottom: 3.6rem;
  }

  .year-no {
    position: relative;
    font-family: var(--font-serif);
    font-size: clamp(2.6rem, 6vw, 4.2rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #5a5070;
    background-image: linear-gradient(90deg, #6b5f82 0%, #c9a8b8 22%, #9b8aa8 44%, #4a4258 56%, #9b8aa8 78%, #6b5f82 100%);
    background-size: 200% 400%;
    background-position: 0 50%;
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    animation: grad-flow 8s linear infinite;
  }

  .month-group {
    margin-top: 1.6rem;
  }

  .month-label {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    color: var(--color-ink-soft);
  }

  .month-list {
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-hair);
  }

  .arch-item {
    display: grid;
    grid-template-columns: 6.2em 1fr;
    gap: 1.15rem;
    align-items: baseline;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--color-hair);
    text-decoration: none;
    color: inherit;
    transition: background 0.32s var(--ease-out-quart);
  }

  .arch-item:hover {
    background: var(--color-panel-2);
  }

  .arch-item time {
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    color: var(--color-ink-soft);
  }

  .arch-item .serif {
    font-family: var(--font-serif);
    font-size: 1.02rem;
    letter-spacing: 0.025em;
    color: var(--color-ink-soft);
    transition: color 0.32s var(--ease-out-quart);
  }

  .arch-item:hover .serif {
    color: var(--color-ink);
  }
</style>
