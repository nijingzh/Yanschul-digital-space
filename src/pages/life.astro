---
/**
 * 生活页 = 空镜与痕迹（生活区：无纱暖白光温，全站暖调仅此页与关于页）
 *
 * 痕迹红线（§9 收口）：痕迹以纯文字呈现，不引入任何角色图、不做图槽位预留。
 * 听歌舞台（裁决 §12B）：静止态 = 歌名 + 一行歌词小字；点击进入 Folia 全屏歌词演出，
 * 演出引擎懒加载（不进视口不加载、点击才注入 iframe）。
 */
import Base from '../layouts/Base.astro';
import Sidenote from '../components/Sidenote.astro';
import { getFeedItems, getMediaNotes } from '../data/content';
import { FOLIA_BASE } from '../lib/config';

const feedItems = await getFeedItems();
const mediaNotes = await getMediaNotes();

const lifeFeed = feedItems.filter((item) => item.href === '/life');
import SparkIcon from '../components/SparkIcon.astro';
const song = mediaNotes.find((note) => note.kind === '在听');
---

<Base title="生活" description="空镜与痕迹 —— 有人住过的房间。">
  <div class="life-room">
    <!-- 暖白无纱层（02 暖侧同语言：白层 + 无纱），禁止冷纱 -->
    <div class="room-warm" aria-hidden="true"></div>

    <header class="life-head">
      <p class="mono life-eyebrow" data-enter>SPACE 03 / LIFE</p>
      <h1 class="page-title life-title icon-hover" data-enter><SparkIcon name="life" />生活</h1>
      <p class="lead life-lead" data-enter>一些没什么用、但很想记下来的瞬间。嗯，就这些。</p>
    </header>

    <!-- 空镜与痕迹（§9 收口 = 纯文字痕迹，无图槽位） -->
    <section class="traces" data-reveal-group aria-label="空镜与痕迹">
      <figure class="trace" data-reveal-item>
        <figcaption>
          <p class="trace-date mono">2026-09-19</p>
          <p class="trace-text">翻到一页没画完的。就先这样吧。</p>
        </figcaption>
      </figure>
      <figure class="trace" data-reveal-item>
        <figcaption>
          <p class="trace-date mono">2026-09-15</p>
          <p class="trace-text">出门前拍的。今天装了两本书，其实只看了一本。</p>
        </figcaption>
      </figure>
      <figure class="trace" data-reveal-item>
        <figcaption>
          <p class="trace-date mono">2026-09-08</p>
          <p class="trace-text">风翻到<Sidenote note="随它" tether>哪页</Sidenote>，就算哪页。</p>
        </figcaption>
      </figure>
      <figure class="trace" data-reveal-item>
        <figcaption>
          <p class="trace-date mono">2026-09-21</p>
          <p class="trace-text">写了一半的开头，比写完的好看。</p>
        </figcaption>
      </figure>
    </section>

    <!-- 此刻状态 -->
    <section class="moment" data-reveal>
      <p class="mono moment-label" data-enter-char>此刻</p>
      <p class="moment-text">在给桌面换壁纸。第三个了，前两个都太亮。</p>
      <p class="trace-date mono">2026-09-21 · 22:40</p>
    </section>

    <!-- 物件三卡（v31：去「在读/在玩/在听」标签，只留物件 + 状态小字；音乐位 = CD 机小卡）-->
    <section class="media" data-reveal-group aria-label="最近记录">
      {
        mediaNotes.map((note) => (
          <div class:list={['media-note', note.kind === '在听' && 'cd-note']} data-reveal-item>
            {note.kind === '在听' && <div class="cd-mini" aria-hidden="true" data-cd-mini></div>}
            <div class="note-body">
              <p class="media-title" data-media-song>{note.title}</p>
              <p class="media-meta" data-media-meta>{note.meta}</p>
              {note.kind === '在听' && (
                <a class="stage-entry magnetic" href="#stage">
                  <span aria-hidden="true">♪</span> 音乐空间 <span aria-hidden="true">✦</span>
                </a>
              )}
            </div>
          </div>
        ))
      }
    </section>

    <!-- 音乐空间（v31 · CD 机卡；原「听歌舞台」——真曲目 + 专辑封面碟 + §12B 懒加载演出）-->
    <section class="stage" id="stage" data-reveal aria-label="音乐空间">
      <p class="mono stage-kind">音乐空间 / MUSIC SPACE</p>
      <div class="music-card">
        <div class="music-grid">
          <button class="cd-disc-wrap magnetic" data-cmd="toggle" type="button" aria-label="播放或暂停">
            <span class="cd-disc" data-cd-disc aria-hidden="true"></span>
          </button>
          <div class="music-info">
            <p class="mono music-eyebrow">♪ 待播放</p>
            <p class="stage-song" data-stage-song>未在播放</p>
            <p class="mono music-artist" data-stage-artist></p>
            <p class="stage-lyric" data-stage-lyric>未在播放</p>
            <div class="music-actions">
              <button class="step-btn mono" data-cmd="prev" type="button" aria-label="上一首" title="上一首">‹‹</button>
              <button class="stage-go" data-cmd="toggle" type="button" aria-label="播放或暂停" title="播放或暂停">
                <svg width="13" height="13" viewBox="0 0 13 13" aria-hidden="true"><path d="M3 1.5 L11.5 6.5 L3 11.5 Z" fill="currentColor"></path></svg>
              </button>
              <button class="step-btn mono" data-cmd="next" type="button" aria-label="下一首" title="下一首">››</button>
              <a class="stage-ext mono" data-stage-ext href={FOLIA_BASE} target="_blank" rel="noopener" aria-label="在 Folia 打开" title="在 Folia 打开">↗</a>
            </div>
          </div>
        </div>
        {/* 播放条（v17 · D 拟态语法 + v35 真进度：可拖 seek） */}
        <div class="mono stage-cmdline">
          <span class="cmd-prompt" aria-hidden="true">$ play</span>
          <span class="stage-track" data-stage-track role="slider" aria-label="播放进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="0"><span class="stage-track-fill" data-stage-fill></span></span>
          <span class="cmd-time"><span data-stage-cur>0:00</span> / <span data-stage-dur>0:00</span></span>
        </div>
      </div>
    </section>

    <!-- v35：弹窗已删——卡片即播放器（CD 封面 + 状态 + 上/播/下 + 可拖进度） -->

    <!-- 最近动态（FeedItem 生活向条目，同源不同视图） -->
    <section class="life-feed" data-reveal-group aria-label="最近动态">
      {
        lifeFeed.map((item) => (
          <a class="life-entry link-grow pressable" data-reveal-item href={item.href}>
            <h2 class="entry-title">{item.title}</h2>
            <p class="entry-desc">{item.desc}</p>
            <p class="entry-date mono">{item.date.replace(/-/g, '.')}</p>
          </a>
        ))
      }
    </section>
  </div>
</Base>

<style>
  .life-room {
    position: relative;
    padding-block: clamp(2.2rem, 5vh, 3.6rem);
  }

  /* 暖白无纱层：02 暖侧同语言（白层 253,253,255，无纱），羽化 12%/88% */
  .room-warm {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background: var(--color-panel);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 88%, transparent);
    pointer-events: none;
  }

  .life-head,
  .traces,
  .moment,
  .media,
  .stage,
  .life-feed {
    position: relative;
    width: calc(100% - 3rem);
    max-width: 56rem;
    margin-inline: auto;
  }

  .life-head {
    margin-bottom: clamp(2.5rem, 6vh, 4.5rem);
  }

  /* 眉标语法：编号 / 英文标签 + 发丝线 */
  .life-eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--color-ink-2);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
  }

  .life-eyebrow::after {
    content: '';
    flex: 0 0 3.5rem;
    height: 1px;
    background: var(--color-hair);
  }

  .life-title {
    margin-top: 0.9rem;
    font-size: clamp(2.15rem, 5vw, 3.15rem);
    letter-spacing: 0.04em;
  }

  .life-lead {
    margin-top: 1.1rem;
    max-width: 42ch;
    color: var(--color-ink-2);
  }

  /* ── 空镜与痕迹：浅色占位块 + 文案 + 可信时间戳 ── */
  /* v23 时间轴切片（方案批准项）：竖线 + ✦ 节点 + 单列图文 */
  .traces {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 3.2rem;
    padding-left: 2.6rem;
  }

  .traces::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: var(--color-hair);
  }

  .trace {
    position: relative;
    width: 100%;
    max-width: 38rem;
    margin: 0;
    display: grid;
    gap: 0.75rem;
    transition:
      transform 700ms var(--ease-space),
      opacity 700ms var(--ease-space);
  }

  /* ✦ 时间轴节点 */
  .trace::before {
    content: '✦';
    position: absolute;
    left: -2.6rem;
    top: 0.35rem;
    width: 11px;
    text-align: center;
    font-size: 11px;
    line-height: 1;
    color: #b2a8de;
    background: var(--color-space-0);
    padding: 2px 0;
  }

  .trace:hover {
    transform: translateY(-3px);
  }

  .traces:hover .trace:not(:hover) {
    opacity: 0.75;
  }

  .trace-text {
    font-family: var(--font-serif);
    font-size: 0.98rem;
    line-height: 1.9;
    max-width: 30ch;
  }

  .trace-date {
    /* v23.8 #5：日期在内容上方（时间先于内容的阅读顺序） */
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    color: var(--color-ink-2);
    opacity: 0.8;
    margin-bottom: 6px;
  }

  /* ── 此刻状态 ── */
  .moment {
    margin-top: clamp(3rem, 7vh, 5rem);
    padding-top: 1.2rem;
    border-top: 1px solid var(--color-hair);
  }

  .moment-label {
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    color: var(--color-ink-2);
  }

  .moment-text {
    margin-top: 0.8rem;
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.9;
    max-width: 36ch;
  }

  /* ── 物件三卡（v31：去「在X」标签；音乐位 = CD 机小卡；三卡等高、状态小字底对齐）── */
  .media {
    margin-top: clamp(3rem, 7vh, 5rem);
    display: grid;
    grid-template-columns: 1fr 1fr 1.35fr;
    gap: 18px;
    align-items: stretch;
  }

  .media-note {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    background: var(--color-panel);
    border: 1px solid var(--color-hair);
    border-radius: 18px;
    padding: 22px 22px 18px;
    min-height: 176px;
  }

  .media-note.cd-note {
    flex-direction: row;
    align-items: center;
    gap: 16px;
  }

  .note-body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    flex: 1;
    min-width: 0;
  }

  .cd-mini {
    flex: none;
    width: 78px;
    height: 78px;
    border-radius: 50%;
    border: 1px solid var(--hair-frame);
    background:
      radial-gradient(circle at 50% 50%, var(--color-space-0) 0 18%, transparent 18.5%),
      conic-gradient(from 210deg, #cfc6e6, #f4f1fa, #c9b8d8, #e9e4f4, #b9a8d0, #f4f1fa, #cfc6e6);
    background-size: cover;
    background-position: center;
    position: relative;
  }

  .cd-mini::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 8px;
    height: 8px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--color-space-0);
    border: 1px solid var(--hair-frame);
  }

  .media-title {
    font-family: var(--font-serif);
    font-size: 1.02rem;
    line-height: 1.5;
  }

  .media-meta {
    font-size: 0.72rem;
    color: var(--color-ink-2);
    line-height: 1.8;
  }

  /* ── 最近动态：发丝线语法 ── */
  .life-feed {
    margin-top: clamp(3rem, 7vh, 5rem);
    border-top: 1px solid var(--color-hair);
  }

  .life-entry {
    display: grid;
    gap: 0.5rem;
    padding: 1.55rem 0 1.45rem;
    border-bottom: 1px solid var(--color-hair);
    color: inherit;
    text-decoration: none;
    box-shadow: var(--shadow-contact);
    transition:
      transform 700ms var(--ease-space),
      opacity 700ms var(--ease-space),
      box-shadow 700ms var(--ease-space);
  }

  .life-entry:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-contact-deep);
  }

  .life-feed:hover .life-entry:not(:hover) {
    opacity: 0.75;
  }

  .entry-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.18rem;
    letter-spacing: 0.03em;
    line-height: 1.4;
  }

  .entry-desc {
    font-size: 0.85rem;
    line-height: 1.9;
    color: var(--color-ink-2);
    max-width: 48ch;
  }

  .entry-date {
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    color: var(--color-ink-2);
    opacity: 0.8;
  }

  @media (max-width: 859px) {
    .trace,
    .trace:nth-child(even) {
      width: 100%;
    }

    .trace:nth-child(even) {
      margin-left: 10px;
    }

    .media {
      grid-template-columns: 1fr;
    }

    .music-grid {
      grid-template-columns: 1fr;
      gap: 24px;
      justify-items: center;
      text-align: center;
    }

    .music-actions {
      justify-content: center;
    }

    .music-card {
      padding: 26px 22px 18px;
    }
  }

  /* ── 音乐空间（v31 · CD 机卡；原「听歌舞台」）── */
  .stage {
    margin-top: clamp(3rem, 7vh, 5rem);
    display: grid;
    gap: 0.7rem;
  }

  .stage-kind {
    font-size: 0.56rem;
    letter-spacing: 0.22em;
    color: var(--color-ink-2);
  }

  .music-card {
    background: var(--color-panel);
    border: 1px solid var(--color-hair);
    border-radius: 22px;
    padding: 34px 38px 22px;
  }

  .music-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 40px;
    align-items: center;
  }

  .cd-disc-wrap {
    display: block;
    width: 220px;
    height: 220px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .cd-disc {
    display: block;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    border: 1px solid var(--hair-frame);
    background:
      radial-gradient(circle at 50% 50%, var(--color-space-0) 0 12%, transparent 12.5%),
      radial-gradient(circle at 38% 32%, rgba(255, 255, 255, 0.85), transparent 42%),
      conic-gradient(from 200deg, #c8bede, #f6f3fb, #c3b0d6, #ece7f6, #b3a0cc, #f6f3fb, #c8bede);
    background-size: cover;
    background-position: center;
    box-shadow: 0 10px 30px rgba(155, 138, 168, 0.18);
    animation: cd-spin 8s linear infinite;
    animation-play-state: paused;
    position: relative;
  }

  /* v34：碟转/停 = 真实播放状态（jy:player 驱动） */
  .cd-disc.is-playing {
    animation-play-state: running;
  }

  .cd-disc::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 58px;
    height: 58px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--color-space-0);
    border: 1px solid var(--hair-frame);
    box-shadow: inset 0 2px 8px rgba(155, 138, 168, 0.16);
  }

  @keyframes cd-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .music-eyebrow {
    font-size: 0.56rem;
    letter-spacing: 0.22em;
    color: var(--color-ink-2);
  }

  /* v32：小窗演出态（静态小点标记，不引新循环动画） */
  .music-card.is-live .music-eyebrow {
    color: var(--color-ink);
  }

  .music-card.is-live .music-eyebrow::before {
    content: "";
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-right: 7px;
    border-radius: 50%;
    background: var(--color-ink);
  }

  /* ── v35 卡片播放器控制（弹窗已删：上/播/下 + 可拖进度） ── */
  .step-btn {
    width: 38px;
    height: 38px;
    flex: none;
    border-radius: 50%;
    border: 1px solid var(--hair-frame);
    background: transparent;
    color: var(--color-ink);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: background 200ms var(--ease-space), transform 200ms var(--ease-space);
  }

  .step-btn:hover {
    background: var(--color-bg-soft);
    transform: translateY(-1px);
  }

  .stage-cmdline {
    display: flex;
    align-items: center;
    gap: 0.95rem;
    margin: 1.15rem 0 0;
    padding: 0.85rem 1.15rem 0;
    border-top: 1px solid var(--hair-frame);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--color-ink-2);
  }

  .cmd-prompt {
    flex: none;
    color: var(--color-ink-2);
  }

  .cmd-time {
    flex: none;
    font-variant-numeric: tabular-nums;
  }

  /* 可拖进度条（v35：鼠标 + 触摸拖动 seek） */
  .stage-track {
    flex: 1;
    height: 4px;
    min-width: 120px;
    background: rgba(31, 27, 51, 0.1);
    border-radius: 99px;
    position: relative;
    cursor: pointer;
    touch-action: none;
  }

  .stage-track:hover {
    height: 6px;
  }

  .stage-track-fill {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 0%;
    background: linear-gradient(90deg, #7a6ba8, #b1a1de);
    border-radius: 99px;
    pointer-events: none;
  }

  .stage-track-fill::after {
    content: "";
    position: absolute;
    right: -6px;
    top: 50%;
    transform: translateY(-50%);
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-ink);
    border: 2px solid var(--color-bg);
    box-shadow: 0 2px 8px rgba(31, 27, 51, 0.28);
  }

  .music-artist {
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--color-ink-2);
    margin-top: 6px;
    min-height: 1em;
  }

  .music-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 22px;
  }

  .stage-go {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--color-ink);
    background: var(--color-ink);
    color: var(--color-panel);
    cursor: pointer;
    transition: transform 220ms var(--ease-space), box-shadow 220ms ease;
  }

  .stage-go:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(29, 29, 34, 0.22);
  }

  .stage-ext {
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    color: var(--color-ink-2);
    text-decoration: none;
    padding: 4px 6px;
    transition: color 180ms ease;
  }

  .stage-ext:hover {
    color: var(--color-ink);
  }

  .stage-song {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.9rem;
    letter-spacing: 0.01em;
    margin-top: 10px;
  }

  .stage-lyric {
    font-family: var(--font-serif);
    font-size: 0.88rem;
    color: var(--color-ink-2);
    line-height: 1.9;
    margin-top: 10px;
    min-height: 1em;
  }

  .stage-cmdline {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 1.15rem;
    padding-top: 14px;
    border-top: 1px solid var(--color-hair);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--color-ink-2);
    font-variant-numeric: tabular-nums;
    text-transform: none; /* 终端拟态保持小写 $ play（mono 类的 uppercase 不适用） */
  }

  .cmd-progress {
    display: inline-block;
    width: 6rem;
    height: 1px;
    background: var(--color-ink-3);
    vertical-align: middle;
  }

  .stage-hint {
    font-size: 0.56rem;
    letter-spacing: 0.18em;
    color: var(--color-ink-3);
  }

  /* v25：三卡排版统一——按钮平时隐形（透明无边=与 meta 行同排版），hover 才现胶囊 */
  .stage-entry {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 0.45rem;
    justify-self: start;
    padding: 6px 13px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: color 180ms ease, border-color 180ms ease, transform 220ms var(--ease-space), box-shadow 220ms ease, background 180ms ease;
  }

  .stage-entry:hover {
    color: var(--color-ink);
    border-color: var(--hair-frame);
    background: var(--color-panel);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(155, 138, 168, 0.25);
  }
</style>

<script>
  import { FOLIA_BASE } from '../lib/config';

  // v35：卡片即播放器（弹窗已删）——jy:track 曲目 / jy:player 播放态 / jy:player-tick 时间轴
  interface TrackDetail {
    id?: number;
    title?: string;
    artist?: string;
    pic?: string;
  }

  interface LyricLine {
    t: number;
    text: string;
  }

  const songTitles = document.querySelectorAll('[data-stage-song]');
  const songArtists = document.querySelectorAll('[data-stage-artist]');
  const songLyric = document.querySelector('[data-stage-lyric]');
  const cdDisc = document.querySelector('[data-cd-disc]');
  const cdMini = document.querySelector('[data-cd-mini]');
  const mediaSong = document.querySelector('.cd-note [data-media-song]');
  const mediaMeta = document.querySelector('.cd-note [data-media-meta]');
  const musicEyebrow = document.querySelector('.music-eyebrow');
  const stageCur = document.querySelector('[data-stage-cur]');
  const stageDur = document.querySelector('[data-stage-dur]');
  const stageFill = document.querySelector('[data-stage-fill]');
  const stageTrack = document.querySelector('[data-stage-track]');

  let lyricLines: LyricLine[] = [];

  const parseLrc = (lrc: string): LyricLine[] => {
    const out: LyricLine[] = [];
    // 制作行黑名单（作词/作曲/编曲…LRC 头部信息不是歌词）
    const creditRe = /^(作词|作曲|编曲|制作人|制作|监制|录音|混音|母带|和声|吉他|贝斯|鼓|键盘|弦乐|出品|原唱|翻唱|录音室|混音师|词：|曲：)/;
    String(lrc || '')
      .split('\n')
      .forEach((line) => {
        const m = line.match(/\[(\d+):(\d+)(?:\.(\d+))?\]/);
        const text = line.replace(/\[[^\]]*\]/g, '').trim();
        if (m && text && !creditRe.test(text)) {
          const t = parseInt(m[1], 10) * 60 + parseInt(m[2], 10) + (m[3] ? parseInt(m[3], 10) / 100 : 0);
          out.push({ t: t, text: text });
        }
      });
    out.sort((a, b) => a.t - b.t);
    return out;
  };

  const fmtTime = (s: number): string => {
    if (!isFinite(s) || s < 0) s = 0;
    const m = Math.floor(s / 60);
    const ss = Math.floor(s % 60);
    return m + ':' + (ss < 10 ? '0' : '') + ss;
  };

  // 播放态上卡（眉标 + 碟转/停 = 真实播放状态）
  const setPlayingUI = (playing: boolean): void => {
    if (cdDisc) cdDisc.classList.toggle('is-playing', playing);
    if (musicEyebrow) musicEyebrow.textContent = playing ? '♪ 正在播放' : '♪ 已暂停';
  };

  const updateLyricAt = (t: number): void => {
    if (!lyricLines.length) return;
    let i = 0;
    for (let k = 0; k < lyricLines.length; k++) {
      if (lyricLines[k].t <= t) i = k;
      else break;
    }
    const line = lyricLines[i] ? lyricLines[i].text : '';
    if (songLyric && line) songLyric.textContent = '「' + line + '」';
  };

  const setLyric = (id: number): void => {
    lyricLines = [];
    if (!id || !FOLIA_BASE) return;
    fetch(FOLIA_BASE + '/api/lyric?id=' + id)
      .then((res) => res.json())
      .then((data: { lrc?: { lyric?: string } }) => {
        lyricLines = parseLrc(data && data.lrc && data.lrc.lyric ? data.lrc.lyric : '');
        if (songLyric && lyricLines.length) songLyric.textContent = '「' + lyricLines[0].text + '」';
      })
      .catch(() => {
        // 歌词拿不到就安静（不打扰播放）
      });
  };

  document.addEventListener('jy:track', (e) => {
    const d = ((e as CustomEvent<TrackDetail>).detail || {}) as TrackDetail;
    songTitles.forEach((el) => {
      el.textContent = d.title || '未在播放';
    });
    songArtists.forEach((el) => {
      el.textContent = d.artist || '';
    });
    if (mediaSong) mediaSong.textContent = d.title || '未在播放';
    if (mediaMeta) mediaMeta.textContent = d.artist || '';
    if (d.pic) {
      const css = 'url("' + d.pic + '")';
      if (cdDisc) cdDisc.style.backgroundImage = css;
      if (cdMini) cdMini.style.backgroundImage = css;
    }
    if (d.id) setLyric(d.id);
  });

  document.addEventListener('jy:player', (e) => {
    const d = ((e as CustomEvent<{ playing?: boolean }>).detail || {}) as { playing?: boolean };
    setPlayingUI(!!d.playing);
  });

  document.addEventListener('jy:player-tick', (e) => {
    const d = ((e as CustomEvent<{ t?: number; d?: number }>).detail || {}) as { t?: number; d?: number };
    updateLyricAt(d.t || 0);
    if (stageCur) stageCur.textContent = fmtTime(d.t || 0);
    if (stageDur) stageDur.textContent = fmtTime(d.d || 0);
    if (stageFill && d.d) (stageFill as HTMLElement).style.width = Math.min(100, ((d.t || 0) / d.d) * 100) + '%';
    if (stageTrack && d.d) stageTrack.setAttribute('aria-valuenow', String(Math.round(((d.t || 0) / d.d) * 100)));
  });

  // 控制指令（同一 audio：MiniPlayer 监听执行）
  document.querySelectorAll<HTMLElement>('[data-cmd]').forEach((el) => {
    el.addEventListener('click', () => {
      const cmd = el.getAttribute('data-cmd') || '';
      document.dispatchEvent(new CustomEvent('jy:player-cmd', { detail: { cmd: cmd } }));
    });
  });

  // v35：进度条拖动 seek（鼠标 + 触摸；拖动中实时跳，跟手）
  const seekFromClientX = (clientX: number): void => {
    if (!stageTrack) return;
    const rect = (stageTrack as HTMLElement).getBoundingClientRect();
    const audio = document.querySelector<HTMLAudioElement>('[data-mini-audio]');
    const d = audio ? audio.duration : 0;
    if (rect.width > 0 && d && isFinite(d)) {
      const ratio = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
      audio.currentTime = ratio * d;
    }
  };

  let dragging = false;
  if (stageTrack) {
    stageTrack.addEventListener('mousedown', (e) => {
      dragging = true;
      seekFromClientX((e as MouseEvent).clientX);
    });
    window.addEventListener('mousemove', (e) => {
      if (dragging) seekFromClientX((e as MouseEvent).clientX);
    });
    window.addEventListener('mouseup', () => {
      dragging = false;
    });
    stageTrack.addEventListener(
      'touchstart',
      (e) => {
        dragging = true;
        const t = (e as TouchEvent).touches[0];
        if (t) seekFromClientX(t.clientX);
      },
      { passive: true }
    );
    stageTrack.addEventListener(
      'touchmove',
      (e) => {
        if (!dragging) return;
        const t = (e as TouchEvent).touches[0];
        if (t) seekFromClientX(t.clientX);
      },
      { passive: true }
    );
    window.addEventListener('touchend', () => {
      dragging = false;
    });
    // 键盘：方向键微调（accessibility）
    stageTrack.addEventListener('keydown', (e) => {
      const audio = document.querySelector<HTMLAudioElement>('[data-mini-audio]');
      const d = audio ? audio.duration : 0;
      if (!audio || !d || !isFinite(d)) return;
      if ((e as KeyboardEvent).key === 'ArrowRight') audio.currentTime = Math.min(d, audio.currentTime + 5);
      else if ((e as KeyboardEvent).key === 'ArrowLeft') audio.currentTime = Math.max(0, audio.currentTime - 5);
    });
  }
</script>
