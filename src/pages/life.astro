---
/**
 * 生活页 = 空镜与痕迹（生活区：无纱暖白光温，全站暖调仅此页与关于页）
 *
 * 痕迹红线（§9 收口）：痕迹以纯文字呈现，不引入任何角色图、不做图槽位预留。
 * 听歌舞台（裁决 §12B）：静止态 = 歌名 + 一行歌词小字；点击进入 Folia 全屏歌词演出，
 * 演出引擎懒加载（不进视口不加载、点击才注入 iframe）。
 */
import Base from '../layouts/Base.astro';
import Sidenote from '../components/Sidenote.astro';
import { getFeedItems, getMediaNotes } from '../data/content';
import { FOLIA_BASE } from '../lib/config';

const feedItems = await getFeedItems();
const mediaNotes = await getMediaNotes();

const lifeFeed = feedItems.filter((item) => item.href === '/life');
import SparkIcon from '../components/SparkIcon.astro';
const song = mediaNotes.find((note) => note.kind === '在听');
---

<Base title="生活" description="空镜与痕迹 —— 有人住过的房间。">
  <div class="life-room">
    <!-- 暖白无纱层（02 暖侧同语言：白层 + 无纱），禁止冷纱 -->
    <div class="room-warm" aria-hidden="true"></div>

    <header class="life-head">
      <p class="mono life-eyebrow" data-enter>SPACE 03 / LIFE</p>
      <h1 class="page-title life-title icon-hover" data-enter><SparkIcon name="life" />生活</h1>
      <p class="lead life-lead" data-enter>一些没什么用、但很想记下来的瞬间。嗯，就这些。</p>
    </header>

    <!-- 空镜与痕迹（§9 收口 = 纯文字痕迹，无图槽位） -->
    <section class="traces" data-reveal-group aria-label="空镜与痕迹">
      <figure class="trace" data-reveal-item>
        <figcaption>
          <p class="trace-date mono">2026-09-19</p>
          <p class="trace-text">翻到一页没画完的。就先这样吧。</p>
        </figcaption>
      </figure>
      <figure class="trace" data-reveal-item>
        <figcaption>
          <p class="trace-date mono">2026-09-15</p>
          <p class="trace-text">出门前拍的。今天装了两本书，其实只看了一本。</p>
        </figcaption>
      </figure>
      <figure class="trace" data-reveal-item>
        <figcaption>
          <p class="trace-date mono">2026-09-08</p>
          <p class="trace-text">风翻到<Sidenote note="随它" tether>哪页</Sidenote>，就算哪页。</p>
        </figcaption>
      </figure>
      <figure class="trace" data-reveal-item>
        <figcaption>
          <p class="trace-date mono">2026-09-21</p>
          <p class="trace-text">写了一半的开头，比写完的好看。</p>
        </figcaption>
      </figure>
    </section>

    <!-- 此刻状态 -->
    <section class="moment" data-reveal>
      <p class="mono moment-label" data-enter-char>此刻</p>
      <p class="moment-text">在给桌面换壁纸。第三个了，前两个都太亮。</p>
      <p class="trace-date mono">2026-09-21 · 22:40</p>
    </section>

    <!-- 物件三卡（v31：去「在读/在玩/在听」标签，只留物件 + 状态小字；音乐位 = CD 机小卡）-->
    <section class="media" data-reveal-group aria-label="最近记录">
      {
        mediaNotes.map((note) => (
          <div class:list={['media-note', note.kind === '在听' && 'cd-note']} data-reveal-item>
            {note.kind === '在听' && <div class="cd-mini" aria-hidden="true" data-cd-mini></div>}
            <div class="note-body">
              <p class="media-title" data-media-song>{note.title}</p>
              <p class="media-meta" data-media-meta>{note.meta}</p>
              {note.kind === '在听' && (
                <a class="stage-entry magnetic" href="#stage">
                  <span aria-hidden="true">♪</span> 音乐空间 <span aria-hidden="true">✦</span>
                </a>
              )}
            </div>
          </div>
        ))
      }
    </section>

    <!-- 音乐空间（v31 · CD 机卡；原「听歌舞台」——真曲目 + 专辑封面碟 + §12B 懒加载演出）-->
    <section class="stage" id="stage" data-reveal aria-label="音乐空间">
      <p class="mono stage-kind">音乐空间 / MUSIC SPACE</p>
      <div class="music-card">
        <div class="music-grid">
          <button class="cd-disc-wrap magnetic" data-song-stage type="button" aria-label="进入歌词演出">
            <span class="cd-disc" data-cd-disc aria-hidden="true"></span>
          </button>
          <div class="music-info">
            <p class="mono music-eyebrow">♪ NOW PLAYING</p>
            <p class="stage-song" data-stage-song>未在播放</p>
            <p class="mono music-artist" data-stage-artist></p>
            <p class="stage-lyric" data-stage-lyric>「船向西飞，夜还长。」</p>
            <div class="music-actions">
              <button class="stage-go" data-song-stage type="button" aria-label="进入歌词演出" title="进入歌词演出">
                <svg width="13" height="13" viewBox="0 0 13 13" aria-hidden="true"><path d="M3 1.5 L11.5 6.5 L3 11.5 Z" fill="currentColor"></path></svg>
              </button>
              <a class="stage-ext mono" data-stage-ext href={FOLIA_BASE} target="_blank" rel="noopener" aria-label="在 Folia 打开" title="在 Folia 打开">↗</a>
            </div>
          </div>
        </div>
        {/* 播放条拟态（v17 · D）：终端语法 + 发丝线进度；纯占位形态 */}
        <p class="mono stage-cmdline" aria-hidden="true">
          $ play ▶ <span class="cmd-progress"></span> 0:00 / 1:47
        </p>
      </div>
    </section>

    <!-- 全屏歌词演出壳（Folia Stage；懒加载注入 iframe，发光仅限演出内） -->
    <div class="stage-overlay" data-stage-overlay aria-hidden="true">
      <button class="stage-close mono" type="button" data-stage-close>关闭</button>
    </div>

    <!-- 最近动态（FeedItem 生活向条目，同源不同视图） -->
    <section class="life-feed" data-reveal-group aria-label="最近动态">
      {
        lifeFeed.map((item) => (
          <a class="life-entry link-grow pressable" data-reveal-item href={item.href}>
            <h2 class="entry-title">{item.title}</h2>
            <p class="entry-desc">{item.desc}</p>
            <p class="entry-date mono">{item.date.replace(/-/g, '.')}</p>
          </a>
        ))
      }
    </section>
  </div>
</Base>

<style>
  .life-room {
    position: relative;
    padding-block: clamp(2.2rem, 5vh, 3.6rem);
  }

  /* 暖白无纱层：02 暖侧同语言（白层 253,253,255，无纱），羽化 12%/88% */
  .room-warm {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background: var(--color-panel);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 88%, transparent);
    pointer-events: none;
  }

  .life-head,
  .traces,
  .moment,
  .media,
  .stage,
  .life-feed {
    position: relative;
    width: calc(100% - 3rem);
    max-width: 56rem;
    margin-inline: auto;
  }

  .life-head {
    margin-bottom: clamp(2.5rem, 6vh, 4.5rem);
  }

  /* 眉标语法：编号 / 英文标签 + 发丝线 */
  .life-eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--color-ink-2);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
  }

  .life-eyebrow::after {
    content: '';
    flex: 0 0 3.5rem;
    height: 1px;
    background: var(--color-hair);
  }

  .life-title {
    margin-top: 0.9rem;
    font-size: clamp(2.15rem, 5vw, 3.15rem);
    letter-spacing: 0.04em;
  }

  .life-lead {
    margin-top: 1.1rem;
    max-width: 42ch;
    color: var(--color-ink-2);
  }

  /* ── 空镜与痕迹：浅色占位块 + 文案 + 可信时间戳 ── */
  /* v23 时间轴切片（方案批准项）：竖线 + ✦ 节点 + 单列图文 */
  .traces {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 3.2rem;
    padding-left: 2.6rem;
  }

  .traces::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: var(--color-hair);
  }

  .trace {
    position: relative;
    width: 100%;
    max-width: 38rem;
    margin: 0;
    display: grid;
    gap: 0.75rem;
    transition:
      transform 700ms var(--ease-space),
      opacity 700ms var(--ease-space);
  }

  /* ✦ 时间轴节点 */
  .trace::before {
    content: '✦';
    position: absolute;
    left: -2.6rem;
    top: 0.35rem;
    width: 11px;
    text-align: center;
    font-size: 11px;
    line-height: 1;
    color: #b2a8de;
    background: var(--color-space-0);
    padding: 2px 0;
  }

  .trace:hover {
    transform: translateY(-3px);
  }

  .traces:hover .trace:not(:hover) {
    opacity: 0.75;
  }

  .trace-text {
    font-family: var(--font-serif);
    font-size: 0.98rem;
    line-height: 1.9;
    max-width: 30ch;
  }

  .trace-date {
    /* v23.8 #5：日期在内容上方（时间先于内容的阅读顺序） */
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    color: var(--color-ink-2);
    opacity: 0.8;
    margin-bottom: 6px;
  }

  /* ── 此刻状态 ── */
  .moment {
    margin-top: clamp(3rem, 7vh, 5rem);
    padding-top: 1.2rem;
    border-top: 1px solid var(--color-hair);
  }

  .moment-label {
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    color: var(--color-ink-2);
  }

  .moment-text {
    margin-top: 0.8rem;
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.9;
    max-width: 36ch;
  }

  /* ── 物件三卡（v31：去「在X」标签；音乐位 = CD 机小卡；三卡等高、状态小字底对齐）── */
  .media {
    margin-top: clamp(3rem, 7vh, 5rem);
    display: grid;
    grid-template-columns: 1fr 1fr 1.35fr;
    gap: 18px;
    align-items: stretch;
  }

  .media-note {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    background: var(--color-panel);
    border: 1px solid var(--color-hair);
    border-radius: 18px;
    padding: 22px 22px 18px;
    min-height: 176px;
  }

  .media-note.cd-note {
    flex-direction: row;
    align-items: center;
    gap: 16px;
  }

  .note-body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    flex: 1;
    min-width: 0;
  }

  .cd-mini {
    flex: none;
    width: 78px;
    height: 78px;
    border-radius: 50%;
    border: 1px solid var(--hair-frame);
    background:
      radial-gradient(circle at 50% 50%, var(--color-space-0) 0 18%, transparent 18.5%),
      conic-gradient(from 210deg, #cfc6e6, #f4f1fa, #c9b8d8, #e9e4f4, #b9a8d0, #f4f1fa, #cfc6e6);
    background-size: cover;
    background-position: center;
    position: relative;
  }

  .cd-mini::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 8px;
    height: 8px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--color-space-0);
    border: 1px solid var(--hair-frame);
  }

  .media-title {
    font-family: var(--font-serif);
    font-size: 1.02rem;
    line-height: 1.5;
  }

  .media-meta {
    font-size: 0.72rem;
    color: var(--color-ink-2);
    line-height: 1.8;
  }

  /* ── 最近动态：发丝线语法 ── */
  .life-feed {
    margin-top: clamp(3rem, 7vh, 5rem);
    border-top: 1px solid var(--color-hair);
  }

  .life-entry {
    display: grid;
    gap: 0.5rem;
    padding: 1.55rem 0 1.45rem;
    border-bottom: 1px solid var(--color-hair);
    color: inherit;
    text-decoration: none;
    box-shadow: var(--shadow-contact);
    transition:
      transform 700ms var(--ease-space),
      opacity 700ms var(--ease-space),
      box-shadow 700ms var(--ease-space);
  }

  .life-entry:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-contact-deep);
  }

  .life-feed:hover .life-entry:not(:hover) {
    opacity: 0.75;
  }

  .entry-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.18rem;
    letter-spacing: 0.03em;
    line-height: 1.4;
  }

  .entry-desc {
    font-size: 0.85rem;
    line-height: 1.9;
    color: var(--color-ink-2);
    max-width: 48ch;
  }

  .entry-date {
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    color: var(--color-ink-2);
    opacity: 0.8;
  }

  @media (max-width: 859px) {
    .trace,
    .trace:nth-child(even) {
      width: 100%;
    }

    .trace:nth-child(even) {
      margin-left: 10px;
    }

    .media {
      grid-template-columns: 1fr;
    }

    .music-grid {
      grid-template-columns: 1fr;
      gap: 24px;
      justify-items: center;
      text-align: center;
    }

    .music-actions {
      justify-content: center;
    }

    .music-card {
      padding: 26px 22px 18px;
    }
  }

  /* ── 音乐空间（v31 · CD 机卡；原「听歌舞台」）── */
  .stage {
    margin-top: clamp(3rem, 7vh, 5rem);
    display: grid;
    gap: 0.7rem;
  }

  .stage-kind {
    font-size: 0.56rem;
    letter-spacing: 0.22em;
    color: var(--color-ink-2);
  }

  .music-card {
    background: var(--color-panel);
    border: 1px solid var(--color-hair);
    border-radius: 22px;
    padding: 34px 38px 22px;
  }

  .music-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 40px;
    align-items: center;
  }

  .cd-disc-wrap {
    display: block;
    width: 220px;
    height: 220px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .cd-disc {
    display: block;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    border: 1px solid var(--hair-frame);
    background:
      radial-gradient(circle at 50% 50%, var(--color-space-0) 0 12%, transparent 12.5%),
      radial-gradient(circle at 38% 32%, rgba(255, 255, 255, 0.85), transparent 42%),
      conic-gradient(from 200deg, #c8bede, #f6f3fb, #c3b0d6, #ece7f6, #b3a0cc, #f6f3fb, #c8bede);
    background-size: cover;
    background-position: center;
    box-shadow: 0 10px 30px rgba(155, 138, 168, 0.18);
    animation: cd-spin 8s linear infinite;
    position: relative;
  }

  .cd-disc::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 58px;
    height: 58px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--color-space-0);
    border: 1px solid var(--hair-frame);
    box-shadow: inset 0 2px 8px rgba(155, 138, 168, 0.16);
  }

  @keyframes cd-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .music-eyebrow {
    font-size: 0.56rem;
    letter-spacing: 0.22em;
    color: var(--color-ink-2);
  }

  .music-artist {
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--color-ink-2);
    margin-top: 6px;
    min-height: 1em;
  }

  .music-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 22px;
  }

  .stage-go {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--color-ink);
    background: var(--color-ink);
    color: var(--color-panel);
    cursor: pointer;
    transition: transform 220ms var(--ease-space), box-shadow 220ms ease;
  }

  .stage-go:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(29, 29, 34, 0.22);
  }

  .stage-ext {
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    color: var(--color-ink-2);
    text-decoration: none;
    padding: 4px 6px;
    transition: color 180ms ease;
  }

  .stage-ext:hover {
    color: var(--color-ink);
  }

  .stage-song {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.9rem;
    letter-spacing: 0.01em;
    margin-top: 10px;
  }

  .stage-lyric {
    font-family: var(--font-serif);
    font-size: 0.88rem;
    color: var(--color-ink-2);
    line-height: 1.9;
    margin-top: 10px;
    min-height: 1em;
  }

  .stage-cmdline {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 1.15rem;
    padding-top: 14px;
    border-top: 1px solid var(--color-hair);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--color-ink-2);
    font-variant-numeric: tabular-nums;
    text-transform: none; /* 终端拟态保持小写 $ play（mono 类的 uppercase 不适用） */
  }

  .cmd-progress {
    display: inline-block;
    width: 6rem;
    height: 1px;
    background: var(--color-ink-3);
    vertical-align: middle;
  }

  .stage-hint {
    font-size: 0.56rem;
    letter-spacing: 0.18em;
    color: var(--color-ink-3);
  }

  /* v25：三卡排版统一——按钮平时隐形（透明无边=与 meta 行同排版），hover 才现胶囊 */
  .stage-entry {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 0.45rem;
    justify-self: start;
    padding: 6px 13px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: color 180ms ease, border-color 180ms ease, transform 220ms var(--ease-space), box-shadow 220ms ease, background 180ms ease;
  }

  .stage-entry:hover {
    color: var(--color-ink);
    border-color: var(--hair-frame);
    background: var(--color-panel);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(155, 138, 168, 0.25);
  }
</style>

<script>
  // v31：CD 机卡与 MiniPlayer 同源（jy:track 广播）+ 真歌词行
  const songTitle = document.querySelector('[data-stage-song]');
  const songArtist = document.querySelector('[data-stage-artist]');
  const songLyric = document.querySelector('[data-stage-lyric]');
  const cdDisc = document.querySelector('[data-cd-disc]');
  const cdMini = document.querySelector('[data-cd-mini]');
  const mediaSong = document.querySelector('.cd-note [data-media-song]');
  const mediaMeta = document.querySelector('.cd-note [data-media-meta]');

  interface TrackDetail {
    id?: number;
    title?: string;
    artist?: string;
    pic?: string;
  }

  const setLyric = (id: number): void => {
    fetch(FOLIA_BASE + '/api/lyric?id=' + id)
      .then((r) => r.json())
      .then((d) => {
        const raw = (d && d.lrc && d.lrc.lyric) || '';
        const line = raw
          .split('\n')
          .map((s: string) => s.replace(/^\[[^\]]*\]/, '').trim())
          .find((s: string) => s && !/^(作词|作曲|编曲|制作|和声|监制|录音|混音|OP|SP)/.test(s));
        if (songLyric) songLyric.textContent = line ? '「' + line + '」' : '';
      })
      .catch(() => {
        // 歌词拉不到就保持示例行
      });
  };

  document.addEventListener('jy:track', (e) => {
    const d = ((e as CustomEvent<TrackDetail>).detail || {}) as TrackDetail;
    if (songTitle) songTitle.textContent = d.title || '未在播放';
    if (songArtist) songArtist.textContent = d.artist || '';
    // 音乐位三卡小卡（只动 cd-note，书/游戏卡不受影响）
    if (mediaSong) mediaSong.textContent = d.title || '未在播放';
    if (mediaMeta) mediaMeta.textContent = d.artist || '';
    if (d.pic) {
      const css = 'url("' + d.pic + '")';
      if (cdDisc) cdDisc.style.backgroundImage = css;
      if (cdMini) cdMini.style.backgroundImage = css;
    }
    if (d.id) setLyric(d.id);
  });

  // 听歌舞台：点击才注入 Folia Stage iframe（演出引擎懒加载）；关闭即释放
  import { FOLIA_BASE, FOLIA_STAGE_URL } from '../lib/config';

  const stageEls = document.querySelectorAll<HTMLElement>('[data-song-stage]');
  const overlay = document.querySelector<HTMLElement>('[data-stage-overlay]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-stage-close]');

  // 演出层必须在最上（§12B.1 禁止垫在任何内容层之下）：搬出 .page 的层叠上下文
  if (overlay && overlay.parentElement !== document.body) {
    document.body.appendChild(overlay);
  }

  const openStage = (): void => {
    if (!overlay) return;
    if (!overlay.querySelector('iframe')) {
      const frame = document.createElement('iframe');
      // v30：Folia 部署地址走单点配置（IP:81 → music.nijingzh.top 只改 env）
      frame.src = FOLIA_STAGE_URL;
      frame.title = '歌词演出';
      frame.allow = 'autoplay';
      // 拒嵌兜底（Folia 当前无 X-Frame-Options 可嵌；若日后加拒嵌头，退新窗口）
      frame.addEventListener('error', () => {
        closeStage();
        window.open(FOLIA_STAGE_URL, '_blank', 'noopener');
      });
      overlay.appendChild(frame);
    }
    overlay.classList.add('is-open');
    overlay.setAttribute('aria-hidden', 'false');
  };

  const closeStage = (): void => {
    if (!overlay) return;
    overlay.classList.remove('is-open');
    overlay.setAttribute('aria-hidden', 'true');
    var stageIframe = overlay.querySelector('iframe');
    if (stageIframe) stageIframe.remove();
  };

  // v31：CD 碟与 ▶ 图标钮都开演出（button 原生 Enter/Space 触发 click，无需手绑键盘）
  stageEls.forEach((el) => el.addEventListener('click', openStage));
  if (closeBtn) closeBtn.addEventListener('click', closeStage);
  // 点演出外的背景也可退回（关闭按钮避让 fixed 导航，双保险）
  if (overlay) overlay.addEventListener('click', (e) => {
    if (e.target === overlay) closeStage();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeStage();
  });
</script>
